{
  "_comment": "A3, interaction terms: the interaction rule and estimator over data/a3/, asking all four report questions.",
  "extends": "default.json",
  "decision_rule": {
    "type": "interaction",
    "active_pairs": 1,
    "zero_pair_main_effects": true,
    "main_scale": 0.5,
    "interaction_magnitude": [
      50,
      100
    ]
  },
  "model_training": {
    "data_dir": "data/a3/"
  },
  "model_estimating": {
    "type": "interaction"
  },
  "report_schema": {
    "batches": [
      "main",
      "interaction",
      "pair_id",
      "pair_value"
    ]
  },
  "model_hyperparameters": {
    "introspection_steps": 600
  }
}
