{
  "_comment": "Plunkett on Qwen3-4B inside a 20GB budget: unquantized, gradient checkpointing, micro-batches of two, shorter reports.",
  "extends": "default.json",
  "report_schema": {
    "max_new_tokens": 96
  },
  "model_hyperparameters": {
    "model_name": "Qwen/Qwen3-4B",
    "quantization": "none",
    "checkpoint_every": 500,
    "gradient_checkpointing": true,
    "micro_batch_size": 2
  },
  "gates": {
    "min_decision_accuracy": 0.6
  },
  "compute": {
    "backend": "local",
    "mixed_precision": "bf16"
  }
}
