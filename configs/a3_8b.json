{
  "_comment": "A3 at Qwen3-8B, 3000 steps. The interaction rule over data/a3/, all four report questions with the pair keys spelled out, 200 estimation trials, and a report budget that fits a ten-slot answer.",
  "extends": "h100_plunkett_8b_20gb.json",
  "decision_rule": {
    "type": "interaction",
    "active_pairs": 1,
    "zero_pair_main_effects": true,
    "main_scale": 0.5,
    "interaction_magnitude": [
      50,
      100
    ]
  },
  "model_training": {
    "data_dir": "data/a3/"
  },
  "model_estimating": {
    "type": "interaction",
    "estimation_trials_per_persona": 200
  },
  "report_schema": {
    "batches": [
      "main",
      "interaction",
      "pair_id",
      "pair_value"
    ],
    "list_pair_keys": true,
    "max_new_tokens": 400
  },
  "model_hyperparameters": {
    "training_steps": 3000,
    "checkpoint_every": 500,
    "introspection_steps": 600
  }
}
