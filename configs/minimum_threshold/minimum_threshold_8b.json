{
  "_comment": [
    "Every setting is in this file; nothing is inherited, so any value can be edited here. README 'Settings' explains each field.",
    "",
    "Notes, written when this file listed only its changes over linear-8b_20gb.json (those values are now written out here too):",
    "The minimum threshold rule at Qwen3-8B, 3000 steps, over data/minimum_threshold/. Three options: A, B, or C (neither) when both options fall below the screen, with a fifth of the training answers C. 200 estimation trials because the cut search needs them, a 400 token report budget, and introspection training branched from decision steps 1500, 2500 and 3000."
  ],
  "object": {
    "type": "vector",
    "attribute_count": 5
  },
  "decision_rule": {
    "type": "minimum_threshold",
    "option_count": 3,
    "min_weight_magnitude": 20,
    "neither_share": 0.2,
    "active_cuts": 1,
    "cut_range": [
      30,
      70
    ],
    "zero_cut_main_effects": true
  },
  "model_training": {
    "data_dir": "data/minimum_threshold/",
    "instances": 100,
    "train_trials_per_persona": 50,
    "val_trials_per_persona": 10,
    "natural_val_trials_per_persona": null,
    "seeds": {
      "roles": 0,
      "weights": 1,
      "trials": 2,
      "verification": 5,
      "introspection": 6,
      "reports": 7,
      "validation": 8
    }
  },
  "model_estimating": {
    "type": "minimum_threshold",
    "decision_temperature": 0.0,
    "samples_per_trial": 1,
    "estimation_trials_per_persona": 200,
    "chance_draws": 1000,
    "shuffle_draws": 1000
  },
  "report_schema": {
    "type": "auto",
    "report_temperature": 0.0,
    "samples_per_report": 10,
    "max_new_tokens": 400
  },
  "model_hyperparameters": {
    "model_name": "Qwen/Qwen3-8B",
    "quantization": "4bit",
    "finetune": "lora",
    "lora_rank": 8,
    "lora_alpha": 8,
    "learning_rate": 0.0002,
    "batch_size": 10,
    "micro_batch_size": 2,
    "gradient_checkpointing": true,
    "loss_mask_answer_only": true,
    "training_steps": 3000,
    "checkpoint_every": 500,
    "baseline_before_training": true,
    "introspection_training": true,
    "introspection_steps": 300,
    "introspection_batch_size": 1,
    "introspection_at_steps": [
      1500,
      2500,
      3000
    ],
    "introspection_targets": [
      "hidden"
    ],
    "introspection_remeasure_decisions": false,
    "lr_schedule": null,
    "max_grad_norm": null,
    "start_from": null,
    "save_optimizer": "all",
    "run_tag": null,
    "seed": 4
  },
  "gates": {
    "min_decision_accuracy": 0.6,
    "min_parse_rate": 0.8
  },
  "compute": {
    "backend": "local",
    "device": "cuda",
    "mixed_precision": "bf16",
    "eval_batch_size": 16,
    "decision_eval_batch_size": null,
    "introspection_eval_batch_size": null,
    "mount_drive": false
  }
}
