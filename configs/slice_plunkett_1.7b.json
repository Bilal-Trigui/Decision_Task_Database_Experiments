{
  "_comment": "Qwen3-1.7B on a 20GB card: unquantized bf16, full batch in one pass with gradient checkpointing.",
  "extends": "default.json",
  "report_schema": {
    "max_new_tokens": 96
  },
  "model_hyperparameters": {
    "model_name": "Qwen/Qwen3-1.7B",
    "quantization": "none",
    "checkpoint_every": 500,
    "gradient_checkpointing": true
  },
  "gates": {
    "min_decision_accuracy": 0.6
  },
  "compute": {
    "backend": "local",
    "mixed_precision": "bf16"
  }
}
