{
  "_comment": "Qwen3-0.6B on a 20GB card: unquantized bf16, micro-batches of five.",
  "extends": "default.json",
  "report_schema": {
    "max_new_tokens": 96
  },
  "model_hyperparameters": {
    "quantization": "none",
    "checkpoint_every": 500,
    "micro_batch_size": 5,
    "gradient_checkpointing": false
  },
  "gates": {
    "min_decision_accuracy": 0.6
  },
  "compute": {
    "backend": "local",
    "mixed_precision": "bf16"
  }
}
