{
  "_comment": "A4, the constrained tradeoff, on Qwen3-8B for 3000 steps, using data/a4/. It uses 200 estimation trials per persona because the cut-point search requires them, and allows 400 tokens per report.",
  "extends": "linear-8b_20gb.json",
  "decision_rule": {
    "type": "tradeoff",
    "active_cuts": 1,
    "cut_range": [
      30,
      70
    ],
    "zero_cut_main_effects": true
  },
  "model_training": {
    "data_dir": "data/a4/"
  },
  "model_estimating": {
    "type": "tradeoff",
    "estimation_trials_per_persona": 200
  },
  "model_hyperparameters": {
    "introspection_steps": 300,
    "training_steps": 3000,
    "checkpoint_every": 500
  },
  "report_schema": {
    "max_new_tokens": 400
  }
}
