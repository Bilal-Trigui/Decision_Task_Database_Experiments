{
  "_comment": "The whole pipeline on a CPU box, four personas and tiny everything, gates off. Proves the plumbing, not a result.",
  "extends": "default.json",
  "model_training": {
    "instances": 4,
    "train_trials_per_persona": 8,
    "val_trials_per_persona": 2
  },
  "model_estimating": {
    "estimation_trials_per_persona": 10,
    "chance_draws": 100
  },
  "report_schema": {
    "samples_per_report": 2,
    "max_new_tokens": 60
  },
  "model_hyperparameters": {
    "quantization": "none",
    "lora_rank": 4,
    "lora_alpha": 4,
    "batch_size": 2,
    "training_steps": 12,
    "checkpoint_every": 6,
    "introspection_steps": 4
  },
  "gates": {
    "min_decision_accuracy": 0.0,
    "min_parse_rate": 0.0
  },
  "compute": {
    "backend": "local",
    "device": "cpu",
    "mixed_precision": "no",
    "eval_batch_size": 4
  }
}
